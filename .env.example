# Copy to .env (repo root or services/api). All values optional; defaults shown.
CAREERPILOT_DATA_DIR=./data
# CAREERPILOT_DATABASE_URL=sqlite:///./data/careerpilot.db
CAREERPILOT_SESSION_TTL_HOURS=168
CAREERPILOT_TIMEZONE=UTC
# Must stay false unless you consent to sending documents to an external LLM provider
CAREERPILOT_ALLOW_EXTERNAL_LLM=false
CAREERPILOT_SCHEDULER_ENABLED=true
CAREERPILOT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CAREERPILOT_LATEX_TIMEOUT_S=60
# Frontend dev server
VITE_API_URL=http://127.0.0.1:8000
